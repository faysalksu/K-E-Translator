{
  "manifest_version": 3,
  "name": "Korean to English Floating Screen Translator",
  "version": "1.4.7",
  "description": "Korean to English floating screenshot translator with K to E button.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://api.ocr.space/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Korean to English Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
